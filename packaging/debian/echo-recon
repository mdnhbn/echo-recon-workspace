#!/bin/sh
set -eu
if [ "$(id -u)" -eq 0 ]; then
  echo 'Run Echo Recon as your normal user, not root.' >&2
  exit 1
fi
data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
export ECHO_RECON_DATA_DIR="$data_home/echo-recon"
export PYTHONDONTWRITEBYTECODE=1
exec /usr/bin/python3 /usr/lib/echo-recon/app.py "$@"
